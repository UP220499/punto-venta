{
  "info": {
    "_postman_id": "pventa-collection-2025",
    "name": "Punto de Venta API",
    "description": "Coleccion oficial del backend Punto de Venta (Fastify + Knex + PostgreSQL).\n\nImporta junto con el environment **Punto de Venta Local**.\n\n**Flujo rapido:**\n1. POST /auth/login -> el script guarda el token automaticamente.\n2. Usa cualquier endpoint protegido; el token se envia en Authorization.\n3. POST /tickets -> guarda ticket_id automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url",  "value": "http://127.0.0.1:3000", "type": "string" },
    { "key": "token",     "value": "",                       "type": "string" },
    { "key": "ticket_id", "value": "1",                      "type": "string" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Has access_token', () => pm.expect(json).to.have.property('access_token'));",
                "if (json.access_token) {",
                "  pm.collectionVariables.set('token', json.access_token);",
                "  pm.environment.set('token', json.access_token);",
                "  console.log('Token saved:', json.access_token.substring(0, 20) + '...');",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica al usuario y guarda el JWT en la variable `token` del environment y de la coleccion."
          }
        },
        {
          "name": "Me (current user)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Has user_id', () => pm.expect(json).to.have.property('user_id'));",
                "pm.test('Has roles array', () => pm.expect(json.roles).to.be.an('array'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Devuelve la informacion del usuario autenticado extraida del JWT."
          }
        }
      ]
    },
